# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (Neon → Connect → copy both strings) ---
# Pooled connection (host contains "-pooler"): used by the app at runtime
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection (no "-pooler"): used only by Prisma migrations
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- App ---
# Public URL of the app. Local dev: the Vite URL (it proxies /auth and /api to Express). Render: https://<app>.onrender.com
APP_URL=http://localhost:5173
# Random 64-char hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# --- GitHub App (github.com → Settings → Developer settings → GitHub Apps → your app) ---
GITHUB_APP_ID=123456
# The part after github.com/apps/ in the app's public URL
GITHUB_APP_SLUG=your-app-name
GITHUB_CLIENT_ID=Iv23xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=replace-me
# The downloaded .pem, base64-encoded onto one line:
#   node -e "console.log(require('fs').readFileSync('path/to/key.pem').toString('base64'))"
GITHUB_PRIVATE_KEY_BASE64=replace-me
# Same random value you typed into the GitHub App's "Webhook secret" field (generate like SESSION_SECRET)
GITHUB_WEBHOOK_SECRET=replace-me
